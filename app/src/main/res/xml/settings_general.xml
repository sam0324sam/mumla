<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/pref_remote_ops_title"
        app:iconSpaceReserved="false">

        <Preference
            android:key="action_upload_debug_log"
            android:title="@string/pref_upload_debug_log"
            android:summary="@string/pref_upload_debug_log_sum"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="action_check_update_now"
            android:title="@string/pref_check_update_now"
            android:summary="@string/pref_check_update_now_sum"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="auto_check_update"
            android:title="@string/pref_auto_check_update"
            android:summary="@string/pref_auto_check_update_sum"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="hub_url"
            android:title="@string/pref_hub_url"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="hub_token"
            android:title="@string/pref_hub_token"
            android:summary="@string/pref_hub_token_sum"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="chatNotify"
        android:summary="@string/chatNotificationsSum"
        android:title="@string/chatNotifications"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:key="stay_awake"
        android:defaultValue="false"
        android:title="@string/stay_awake"
        android:summary="@string/stay_awake_sum"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="autoReconnect"
        android:summary="@string/autoReconnectSum"
        android:title="@string/autoReconnect"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="forceTcp"
        android:summary="@string/forceTcpSum"
        android:title="@string/forceTcp"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:title="@string/pref_timezone_guardian_title"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="auto_timezone"
            android:summary="@string/pref_auto_timezone_sum"
            android:title="@string/pref_auto_timezone"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="Asia/Taipei"
            android:entries="@array/timezoneNames"
            android:entryValues="@array/timezoneValues"
            android:key="manual_timezone"
            app:useSimpleSummaryProvider="true"
            android:title="@string/pref_manual_timezone"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
