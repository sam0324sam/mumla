# Port inside container
PORT=8088

# Shared secret between walkie-talkies (mumla_config.json -> hubToken) and this NAS hub
HUB_TOKEN=change_me_to_a_random_secret

# Upstream Mumla repo & rolling release tag to proxy for OTA updates
GITHUB_REPO=sam0324sam/mumla
RELEASE_TAG=dev-latest

# Optional: GitHub token for reading releases (avoids 60 req/hr anonymous rate limit)
GITHUB_READ_TOKEN=

# Private GitHub repo where uploaded device logs are automatically pushed
GITHUB_LOG_REPO=sam0324sam/mumla-logs
# Fine-grained PAT with Contents: Read & Write ONLY on sam0324sam/mumla-logs
GITHUB_LOG_TOKEN=

# Cache release metadata for 2 minutes
CACHE_TTL_SEC=120
