# Port inside container
PORT=8088

# Shared password between walkie-talkies (mumla_config.json -> hubToken) and web log viewer
HUB_TOKEN=change_me_to_a_random_secret

# Optional: set a separate password for viewing logs in browser (leave empty to reuse HUB_TOKEN)
LOG_VIEW_PASSWORD=

# Upstream Mumla repo & rolling release tag to proxy for OTA updates
GITHUB_REPO=sam0324sam/mumla
RELEASE_TAG=dev-latest

# Optional: GitHub token for reading releases (avoids 60 req/hr anonymous rate limit)
GITHUB_READ_TOKEN=

# Cache release metadata for 2 minutes
CACHE_TTL_SEC=120

# Maximum number of log files kept on NAS disk
MAX_LOCAL_LOGS=100
